---
import type { Project } from '../data/projects';
import StoreLinks from './StoreLinks.astro';
interface Props { project: Project }
const { project: p } = Astro.props;
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '') + '/'}${path}`;
---
<article class:list={['project-card', { featured: p.featured }]}>
  <div class:list={['project-heading', { 'featured-heading': p.featured }]}>
    <span class="game-icon"><img src={asset(p.icon)} alt="" width="48" height="48" loading="lazy" /></span>
    <div><h3>{p.title}</h3><p class="role">{p.role.split(' & ').map((role, index) => <Fragment>{index > 0 && ' & '}<span class:list={{ 'role-developer': role === 'Game Developer', 'role-designer': role === 'Game Designer' }}>{role}</span></Fragment>)}</p></div>
  </div>
  <div class="project-media">
    <video class="inline-video" src={asset(p.video)} poster={asset(p.poster)} controls playsinline preload="auto" aria-label={`${p.title} — gameplay video`}>
    </video>
    <p class="video-error" role="alert" hidden>Video could not be loaded. Please try again.</p>
    <p class="video-status" role="status" hidden>Loading video…</p>
    <button class="video-trigger" data-video={asset(p.video)} data-title={p.title} aria-label={`Play ${p.title} gameplay video`} hidden><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="play-symbol" d="M6 3L17 10L6 17Z" fill="currentColor" /><path class="pause-symbol" d="M5 3H8V17H5ZM12 3H15V17H12Z" fill="currentColor" /></svg></button>
    <button class="fullscreen-trigger" aria-label={`View ${p.title} in fullscreen`} hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 3H3V9M15 3H21V9M3 15V21H9M21 15V21H15" /></svg></button>
  </div>
  <div class="project-info">
    <p class="contribution">{p.contribution}</p>
    {p.featured && <div class="metrics"><p>{p.downloads || 'Metrics coming soon'}</p><span>{p.downloads ? 'GAME DOWNLOADS' : 'GAME DOWNLOADS · PLACEHOLDER'}</span></div>}
    {p.featured && <StoreLinks appStore={p.appStore} googlePlay={p.googlePlay} />}
  </div>
  {!p.featured && <StoreLinks appStore={p.appStore} googlePlay={p.googlePlay} />}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-trigger').forEach(button => {
    const media = button.closest<HTMLElement>('.project-media')!;
    const video = media.querySelector('video')! as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
    const error = media.querySelector<HTMLElement>('.video-error')!;
    const status = media.querySelector<HTMLElement>('.video-status')!;
    const fullscreen = media.querySelector<HTMLButtonElement>('.fullscreen-trigger')!;
    let starting = false;
    let playAttempt = 0;
    let playFailed = false;
    const setLoading = (loading: boolean) => {
      status.hidden = !loading;
      button.setAttribute('aria-busy', String(loading));
    };
    video.controls = false;
    button.hidden = false;
    video.volume = 0.5;
    fullscreen.hidden = !(document.fullscreenEnabled || video.webkitEnterFullscreen);
    fullscreen.addEventListener('click', async () => {
      error.hidden = true;
      video.controls = true;
      try {
        if (document.fullscreenEnabled) await video.requestFullscreen();
        else video.webkitEnterFullscreen?.();
      } catch {
        video.controls = false;
        error.textContent = 'Fullscreen could not be opened. Please try again.';
        error.hidden = false;
      }
    });
    let inFullscreen = false;
    const syncFullscreen = (active: boolean) => {
      const wasFullscreen = inFullscreen;
      inFullscreen = active;
      video.controls = active;
      if (wasFullscreen && !active && !document.fullscreenElement) fullscreen.focus({ preventScroll: true });
    };
    document.addEventListener('fullscreenchange', () => syncFullscreen(document.fullscreenElement === video));
    video.addEventListener('webkitbeginfullscreen', () => syncFullscreen(true));
    video.addEventListener('webkitendfullscreen', () => syncFullscreen(false));
    const update = () => {
      media.classList.toggle('is-playing', !video.paused);
      button.classList.toggle('is-playing', !video.paused);
      button.setAttribute('aria-label', `${video.paused ? (playFailed ? 'Retry' : 'Play') : 'Pause'} ${button.dataset.title} video`);
    };
    const showPlaybackError = (message: string) => {
      ++playAttempt;
      starting = false;
      video.pause();
      playFailed = true;
      setLoading(false);
      error.textContent = message;
      error.hidden = false;
      update();
    };
    button.addEventListener('click', async () => {
      const attempt = ++playAttempt;
      error.hidden = true;
      playFailed = false;
      if (starting || !video.paused) {
        starting = false;
        video.pause();
        setLoading(false);
        update();
        return;
      }
      starting = true;
      setLoading(true);
      if (video.error) video.load();
      try { await video.play(); }
      catch (cause) {
        if (attempt === playAttempt && !(cause instanceof DOMException && cause.name === 'AbortError')) {
          showPlaybackError('Video could not play. Check your connection and press play to retry.');
        }
      } finally {
        if (attempt === playAttempt) {
          starting = false;
          setLoading(false);
          update();
        }
      }
    });
    video.addEventListener('play', () => {
      document.querySelectorAll('video').forEach(other => { if (other !== video) other.pause(); });
      update();
    });
    video.addEventListener('loadstart', () => { if (error.hidden && (starting || !video.paused)) setLoading(true); });
    video.addEventListener('loadeddata', () => setLoading(false));
    video.addEventListener('canplay', () => setLoading(false));
    video.addEventListener('playing', () => { error.hidden = true; playFailed = false; setLoading(false); update(); });
    ['waiting', 'stalled'].forEach(event => video.addEventListener(event, () => {
      if (!video.paused || starting) setLoading(true);
    }));
    ['pause', 'ended'].forEach(event => video.addEventListener(event, () => { setLoading(false); update(); }));
    video.addEventListener('error', () => showPlaybackError('Video could not load. Check your connection and press play to retry.'));
    if (video.error) showPlaybackError('Video could not load. Check your connection and press play to retry.');
  });
</script>
